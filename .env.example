# AI Engineering Project OS - Environment Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/ai_engineering.db

# GitHub Integration (optional)
GITHUB_TOKEN=
GITHUB_TIMEOUT=300

# Workspace
WORKSPACE_ROOT=./workspaces
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=300

# Execution Runtime
EXECUTION_TIMEOUT_SECONDS=120
MAX_OUTPUT_LINES=1000

# Logging
LOG_LEVEL=INFO
